{
  "$id": "https://github.com/yuvalrakavy/tracing-init/schemas/error.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Error/{instance}",
  "description": "Never retained: a request refused or failed. reason superseded when a change at the device won an outage conflict.",
  "type": "object",
  "required": [
    "error",
    "reason"
  ],
  "properties": {
    "error": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "property": {
      "type": "string"
    },
    "command": {
      "type": "string"
    },
    "request-id": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "description": "Original optional canonical SHA-256 request identity; independent of traceparent."
    },
    "reason": {
      "enum": [
        "malformed",
        "refused",
        "rejected",
        "unusable",
        "unsupported",
        "superseded",
        "link_lost"
      ]
    }
  },
  "additionalProperties": false
}
