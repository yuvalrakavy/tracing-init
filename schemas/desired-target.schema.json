{
  "$id": "https://github.com/yuvalrakavy/tracing-init/schemas/desired-target.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Desired/{instance}/{target}",
  "description": "Never retained: several properties of one target, set atomically.",
  "type": "object",
  "minProperties": 1,
  "propertyNames": {
    "pattern": "^[^/+#]+$"
  },
  "additionalProperties": {
    "type": [
      "string",
      "number",
      "integer",
      "boolean",
      "null"
    ]
  }
}
